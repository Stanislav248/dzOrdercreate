<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Створення замовлення</title>
    <style>
            .form-group {
                margin-bottom: 15px;
            }

            label {
                display: block;
                font-weight: bold;
            }

            .error {
                color: red;
                font-size: 0.9em;
                display: none;
            }
    </style>
</head>
<body>

    <h2>Нове замовлення</h2>
    <form id="orderForm">
        <div class="form-group">
            <label>Назва (від 3 до 50 знаків):</label>
            <input type="text" id="title" required minlength="3" maxlength="50">
            <span class="error" id="titleError">Назва обов'язкова (3-50 символів).</span>
        </div>

        <div class="form-group">
            <label>Опис:</label>
            <textarea id="description"></textarea>
        </div>

        <div class="form-group">
            <label>Ціна (1 - 10000):</label>
            <input type="number" id="price" min="1" max="10000" step="0.01" required>
            <span class="error" id="priceError">Ціна має бути від 1 до 10000.</span>
        </div>

        <div class="form-group">
            <label>Кількість (1 - 100):</label>
            <input type="number" id="quantity" min="1" max="100" required value="1">
            <span class="error" id="quantityError">Кількість має бути від 1 до 100.</span>
        </div>

        <div class="form-group">
            <label>Загальна вартість:</label>
            <input type="text" id="totalPrice" readonly value="0.00">
        </div>

        <button type="submit">Створити замовлення</button>
    </form>

    <script>
            const priceInput = document.getElementById('price');
            const quantityInput = document.getElementById('quantity');
            const totalPriceInput = document.getElementById('totalPrice');

            // Автоматичне обчислення TotalPrice на клієнті
            function calculateTotal() {
                const price = parseFloat(priceInput.value) || 0;
                const quantity = parseInt(quantityInput.value) || 0;
                totalPriceInput.value = (price * quantity).toFixed(2);
            }

            priceInput.addEventListener('input', calculateTotal);
            quantityInput.addEventListener('input', calculateTotal);

            // Відправка форми на сервер
            document.getElementById('orderForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const orderData = {
                    title: document.getElementById('title').value,
                    description: document.getElementById('description').value,
                    price: parseFloat(priceInput.value),
                    quantity: parseInt(quantityInput.value)
                };

                const response = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData)
                });

                if (response.ok) {
                    alert('Замовлення успішно створено!');
                    document.getElementById('orderForm').reset();
                    totalPriceInput.value = "0.00";
                } else {
                    const errors = await response.json();
                    alert('Помилка валідації на сервері: ' + JSON.stringify(errors));
                }
            });
    </script>
</body>
</html>

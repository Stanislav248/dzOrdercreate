@model WebApplication.Models.UserModel

@{
    ViewData["Title"] = "Підтвердження";
}

<div class="alert alert-success mt-4">
    <h2>Користувача успішно зареєстровано та записано у файл!</h2>
</div>

<h3>Дані підтвердження:</h3>
<table class="table table-bordered mt-3">
    <tr>
        <th>Ім'я</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>
    <tr>
        <th>Вік</th>
        <td>@Model.Age</td>
    </tr>
    <tr>
        <th>Телефон</th>
        <td>@Model.Phone</td>
    </tr>
    <tr>
        <th>Спеціальний рядок</th>
        <td>@Model.CustomLine</td>
    </tr>
</table>

<a asp-action="Register" class="btn btn-secondary">Назад до реєстрації</a>
